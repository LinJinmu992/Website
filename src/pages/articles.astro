---
import Layout from '../layouts/Layout.astro';
import { posts } from '../data/posts';

const categories = ['日常', '笔记'] as const;
const articlePosts = categories
	.flatMap((category) => posts.filter((post) => post.category === category).slice(0, 10))
	.sort((a, b) => b.date.localeCompare(a.date));
---

<Layout title="文章 · 林衿慕">
	<script is:inline>
		(() => {
			try {
				const raw = sessionStorage.getItem('linjinmu:articles-return');
				if (!raw) return;
				const state = JSON.parse(raw);
				document.documentElement.dataset.articlesReturning = 'true';
				if (state?.filter) {
					document.documentElement.dataset.articleFilter = state.filter;
				}
			} catch {
				document.documentElement.removeAttribute('data-articles-returning');
				document.documentElement.removeAttribute('data-article-filter');
			}
		})();
	</script>
	<section class="articles">
		<p class="eyebrow">Articles</p>
		<div class="articles-head">
			<div>
				<h1>文章</h1>
				<p class="lead">日常的片段与留下来的笔记。</p>
			</div>
			<div class="filters" role="group" aria-label="筛选文章">
				<button type="button" data-filter="全部" aria-pressed="true">全部</button>
				<button type="button" data-filter="日常" aria-pressed="false">日常</button>
				<button type="button" data-filter="笔记" aria-pressed="false">笔记</button>
			</div>
		</div>

		<div class="article-grid is-entering" aria-live="polite">
			{articlePosts.map((post, index) => (
				<article
					data-category={post.category}
					data-slug={post.slug}
					style={`--card-delay: ${0.36 + index * 0.06}s`}
				>
					<div class="card-meta">
						<span>{post.category}</span>
						<time datetime={post.date}>{post.date.replaceAll('-', ' / ')}</time>
					</div>
					<h2><a href={`/posts/${post.slug}`} data-article-link>{post.title}</a></h2>
					<p>{post.description}</p>
					<a class="card-link" href={`/posts/${post.slug}`} data-article-link aria-label={`阅读《${post.title}》`}>阅读文章 ↗</a>
				</article>
			))}
		</div>
		<a class="archive-link" href="/archive">更多文章，请前往归档查看 →</a>
	</section>

	<script>
		const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
		const cards = document.querySelectorAll<HTMLElement>('[data-category]');
		const grid = document.querySelector<HTMLElement>('.article-grid');
		const articleLinks = document.querySelectorAll<HTMLAnchorElement>('[data-article-link]');
		const stateKey = 'linjinmu:articles-return';

		window.setTimeout(() => grid?.classList.remove('is-entering'), 1550);

		const waitForStableScroll = (callback: () => void) => {
			window.requestAnimationFrame(() => {
				window.requestAnimationFrame(callback);
			});
		};

		const isInViewport = (element: HTMLElement) => {
			const rect = element.getBoundingClientRect();
			return rect.bottom > 0 && rect.top < window.innerHeight;
		};

		const playReturnAnimation = () => {
			if (!window.matchMedia('(prefers-reduced-motion: no-preference)').matches) {
				document.documentElement.removeAttribute('data-articles-returning');
				document.documentElement.removeAttribute('data-article-filter');
				return;
			}

			const visibleCards = Array.from(cards).filter((card) => !card.hidden && isInViewport(card));
			const delayStep = 0.065;

			visibleCards.forEach((card, index) => {
				card.style.setProperty('--return-delay', `${index * delayStep}s`);
				card.classList.remove('return-enter');
				void card.offsetWidth;
				card.classList.add('return-enter');
			});

			const cleanupDelay = 580 + Math.max(0, visibleCards.length - 1) * delayStep * 1000;
			window.setTimeout(() => {
				document.documentElement.removeAttribute('data-articles-returning');
				document.documentElement.removeAttribute('data-article-filter');
				window.requestAnimationFrame(() => {
					visibleCards.forEach((card) => {
						card.classList.remove('return-enter');
						card.style.removeProperty('--return-delay');
					});
				});
			}, cleanupDelay);
		};

		const applyFilter = (filter = '全部', animate = true) => {
			grid?.classList.remove('is-entering');

			buttons.forEach((item) => {
				item.setAttribute('aria-pressed', String(item.dataset.filter === filter));
			});

			cards.forEach((card) => {
				const visible = filter === '全部' || card.dataset.category === filter;
				card.hidden = !visible;
				if (visible) {
					card.classList.remove('filter-enter');
					if (animate) {
						void card.offsetWidth;
						card.classList.add('filter-enter');
						card.addEventListener(
							'animationend',
							() => card.classList.remove('filter-enter'),
							{ once: true },
						);
					}
				}
			});
		};

		buttons.forEach((button) => {
			button.addEventListener('click', () => {
				applyFilter(button.dataset.filter);
			});
		});

		articleLinks.forEach((link) => {
			link.addEventListener('click', () => {
				const card = link.closest<HTMLElement>('[data-slug]');
				const active = Array.from(buttons).find((button) => button.getAttribute('aria-pressed') === 'true');
				sessionStorage.setItem(
					stateKey,
					JSON.stringify({
						filter: active?.dataset.filter ?? '全部',
						slug: card?.dataset.slug,
						scrollY: window.scrollY,
					}),
				);
			});
		});

		const restoreState = () => {
			const raw = sessionStorage.getItem(stateKey);
			if (!raw) return;
			sessionStorage.removeItem(stateKey);

			try {
				const state = JSON.parse(raw) as { filter?: string; slug?: string; scrollY?: number };
				applyFilter(state.filter ?? '全部', false);

				window.requestAnimationFrame(() => {
					if (typeof state.scrollY === 'number') {
						window.scrollTo({ top: state.scrollY, behavior: 'instant' as ScrollBehavior });
						waitForStableScroll(playReturnAnimation);
						return;
					}

					const target = state.slug
						? document.querySelector<HTMLElement>(`[data-slug="${CSS.escape(state.slug)}"]`)
						: null;
					target?.scrollIntoView({ block: 'center', behavior: 'instant' as ScrollBehavior });
					waitForStableScroll(playReturnAnimation);
				});
			} catch {
				sessionStorage.removeItem(stateKey);
				document.documentElement.removeAttribute('data-articles-returning');
				document.documentElement.removeAttribute('data-article-filter');
			}
		};

		restoreState();
	</script>
</Layout>

<style>
	.articles { padding-top: 58px; }
	.articles-head {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		gap: 32px;
		margin-bottom: 68px;
	}
	h1 { margin: 0; font-size: 40px; font-weight: 500; }
	.lead { margin: 14px 0 0; color: var(--muted); font-size: 14px; }
	.filters {
		display: flex;
		gap: 3px;
		padding: 3px;
		border: 1px solid var(--line);
		border-radius: 999px;
	}
	.filters button {
		padding: 6px 12px;
		border: 0;
		border-radius: 999px;
		background: transparent;
		color: var(--muted);
		font: inherit;
		font-size: 11px;
		cursor: pointer;
		transition: color .2s ease, background .2s ease;
	}
	.filters button:hover { color: var(--text); }
	.filters button[aria-pressed='true'] {
		background: var(--text);
		color: var(--bg);
	}
	.article-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 18px;
	}
	.article-grid article {
		display: flex;
		flex-direction: column;
		min-height: 220px;
		padding: 26px;
		border: 1px solid var(--line);
		border-radius: 9px;
		background: color-mix(in srgb, var(--bg) 94%, var(--text));
		transition: border-color .25s ease, transform .25s ease, background .25s ease;
	}
	.article-grid article:hover {
		transform: translateY(-3px);
		border-color: var(--faint);
		background: var(--bg);
	}
	html[data-article-filter='日常'] .article-grid article:not([data-category='日常']),
	html[data-article-filter='笔记'] .article-grid article:not([data-category='笔记']) {
		display: none;
	}
	html[data-article-filter='日常'] .filters button[aria-pressed='true'],
	html[data-article-filter='笔记'] .filters button[aria-pressed='true'] {
		background: transparent;
		color: var(--muted);
	}
	html[data-article-filter='日常'] .filters button[data-filter='日常'],
	html[data-article-filter='笔记'] .filters button[data-filter='笔记'] {
		background: var(--text);
		color: var(--bg);
	}
	html[data-articles-returning='true'] .article-grid article {
		opacity: 0;
		transform: translateY(12px);
	}
	.article-grid article[hidden] { display: none; }
	.card-meta {
		display: flex;
		justify-content: space-between;
		color: var(--faint);
		font-size: 10px;
		letter-spacing: .05em;
	}
	.card-meta span { color: var(--accent); }
	.article-grid h2 {
		margin: 30px 0 10px;
		font-family: inherit;
		font-size: 20px;
		font-weight: 560;
		line-height: 1.45;
	}
	.article-grid h2 a:hover { color: var(--accent); }
	.article-grid p {
		margin: 0 0 24px;
		color: var(--muted);
		font-size: 13px;
		line-height: 1.7;
	}
	.card-link {
		margin-top: auto;
		color: var(--faint);
		font-size: 11px;
		transition: color .2s ease;
	}
	.card-link:hover { color: var(--accent); }
	.archive-link {
		display: block;
		width: fit-content;
		margin: 46px auto 0;
		color: var(--muted);
		font-size: 12px;
		text-underline-offset: 5px;
	}
	.archive-link:hover { color: var(--accent); text-decoration: underline; }
	.filter-enter { animation: filter-enter .36s cubic-bezier(.22, .72, .24, 1) both; }
	@keyframes filter-enter {
		from { opacity: 0; transform: translateY(7px); }
		to { opacity: 1; transform: translateY(0); }
	}
	@media (prefers-reduced-motion: no-preference) {
		.article-grid.is-entering article {
			animation: card-enter .62s cubic-bezier(.22, .72, .24, 1) var(--card-delay) backwards;
		}
		@keyframes card-enter {
			from { opacity: 0; transform: translateY(10px); }
			to { opacity: 1; transform: translateY(0); }
		}
		.article-grid article.filter-enter { animation: filter-enter .36s cubic-bezier(.22, .72, .24, 1) both; }
		.article-grid article.return-enter {
			animation: article-return .52s cubic-bezier(.22, .72, .24, 1) var(--return-delay, 0s) both;
		}
		@keyframes article-return {
			from { opacity: 0; transform: translateY(12px); }
			to { opacity: 1; transform: translateY(0); }
		}
	}
	@media (max-width: 680px) {
		.articles { padding-top: 42px; }
		.articles-head { flex-direction: column; margin-bottom: 48px; }
		.filters { align-self: flex-end; }
		.article-grid { grid-template-columns: 1fr; }
		.article-grid article { min-height: 200px; }
	}
</style>
