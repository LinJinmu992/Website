---
import Layout from '../layouts/Layout.astro';
import { posts } from '../data/posts';

const recentPosts = posts.slice(0, 10);
---

<Layout>
	<section class="intro">
		<p class="eyebrow">Notes from everyday life</p>
		<h1>你好，我是林衿慕。<br />这里写设计、技术，<br />以及生活留下的微小回声。</h1>
		<p class="intro-note">不追赶信息，只收藏值得反复想起的东西。</p>
	</section>

	<section class="recent" aria-labelledby="recent-title">
		<div class="section-head">
			<h2 id="recent-title">最近文章</h2>
			<span>{String(recentPosts.length).padStart(2, '0')} 篇</span>
		</div>

		<div class="reading-layout">
			<div class="post-list">
				{recentPosts.map((post, index) => (
					<article
						data-post={post.slug}
						style={`--reveal-delay: ${0.46 + index * 0.08}s`}
					>
						<div class="post-meta">
							<time datetime={post.date}>{post.displayDate}</time>
							<span>{post.category}</span>
						</div>
						<div>
							<h3>
								<a href={`/posts/${post.slug}`} data-preview-link={post.slug}>{post.title}</a>
							</h3>
							<p>{post.description}</p>
						</div>
						<a
							class="arrow"
							href={`/posts/${post.slug}`}
							data-preview-link={post.slug}
							aria-label={`阅读《${post.title}》`}
						>↗</a>
					</article>
				))}
			</div>

			<aside class="article-preview" aria-live="polite">
				<button class="preview-close" type="button" aria-label="关闭文章预览">×</button>
				{recentPosts.map((post) => {
					const Content = post.Content;
					return (
						<article class="preview-content" data-preview={post.slug} hidden>
							<p class="preview-kicker">Reading now</p>
							<h2>{post.title}</h2>
							<div class="preview-meta">
								<time datetime={post.date}>{post.date.replaceAll('-', ' / ')}</time>
								<span>{post.category}</span>
								<span>{post.readTime}阅读</span>
							</div>
							<div class="preview-prose">
								<Content />
							</div>
							<a class="open-page" href={`/posts/${post.slug}`}>在独立页面阅读 →</a>
						</article>
					);
				})}
			</aside>
		</div>
	</section>

	<script>
		const recent = document.querySelector<HTMLElement>('.recent');
		const page = document.querySelector<HTMLElement>('.page');
		const preview = document.querySelector<HTMLElement>('.article-preview');
		const postList = document.querySelector<HTMLElement>('.post-list');
		const closeButton = document.querySelector<HTMLButtonElement>('.preview-close');
		const desktop = window.matchMedia('(min-width: 900px)');
		const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
		let previewSwitchId = 0;
		let handoffTarget: number | null = null;
		let handoffFrame = 0;
		let handoffTime = 0;

		const stopHandoff = () => {
			if (handoffFrame) window.cancelAnimationFrame(handoffFrame);
			handoffFrame = 0;
			handoffTarget = null;
			handoffTime = 0;
		};

		const animateHandoff = (time: number) => {
			if (handoffTarget === null) {
				handoffFrame = 0;
				return;
			}

			const current = window.scrollY;
			const distance = handoffTarget - current;
			if (Math.abs(distance) < .5) {
				window.scrollTo({ top: handoffTarget, behavior: 'instant' as ScrollBehavior });
				stopHandoff();
				return;
			}

			const elapsed = handoffTime ? Math.min(time - handoffTime, 32) : 16;
			handoffTime = time;
			const easing = 1 - Math.exp(-elapsed / 70);
			window.scrollTo({
				top: current + distance * easing,
				behavior: 'instant' as ScrollBehavior,
			});
			handoffFrame = window.requestAnimationFrame(animateHandoff);
		};

		const scrollPageBy = (delta: number) => {
			const max = Math.max(0, document.documentElement.scrollHeight - window.innerHeight);
			const origin = handoffTarget ?? window.scrollY;
			handoffTarget = Math.min(max, Math.max(0, origin + delta));

			if (reducedMotion.matches) {
				window.scrollTo({ top: handoffTarget, behavior: 'instant' as ScrollBehavior });
				stopHandoff();
			} else if (!handoffFrame) {
				handoffFrame = window.requestAnimationFrame(animateHandoff);
			}
		};

		function closePreview() {
			previewSwitchId++;
			stopHandoff();
			recent?.classList.remove('is-reading');
			page?.classList.remove('reading-mode');
			document.querySelectorAll('[data-post]').forEach((item) => item.removeAttribute('data-active'));
			document.querySelectorAll<HTMLElement>('[data-preview-active]').forEach((item) => {
				item.removeAttribute('data-preview-active');
			});
			window.setTimeout(() => {
				if (!recent?.classList.contains('is-reading')) {
					document.querySelectorAll<HTMLElement>('[data-preview]').forEach((item) => {
						item.hidden = true;
						item.classList.remove('preview-enter', 'preview-leave');
					});
				}
			}, 450);
		}

		document.querySelectorAll<HTMLAnchorElement>('[data-preview-link]').forEach((link) => {
			link.addEventListener('click', (event) => {
				if (!desktop.matches) return;
				event.preventDefault();
				const slug = link.dataset.previewLink;
				if (!slug) return;

				const currentPreview = document.querySelector<HTMLElement>('[data-preview-active], .preview-leave');
				const nextPreview = document.querySelector<HTMLElement>(`[data-preview="${slug}"]`);
				if (!nextPreview || currentPreview === nextPreview) return;
				const switchId = ++previewSwitchId;

				document.querySelectorAll<HTMLElement>('[data-preview]').forEach((item) => {
					if (item !== currentPreview && item !== nextPreview) {
						item.hidden = true;
						item.classList.remove('preview-enter', 'preview-leave');
						item.removeAttribute('data-preview-active');
					}
				});

				const showNextPreview = () => {
					if (switchId !== previewSwitchId) return;
					nextPreview.hidden = false;
					nextPreview.classList.remove('preview-enter', 'preview-leave');
					void nextPreview.offsetWidth;
					nextPreview.setAttribute('data-preview-active', '');
					nextPreview.classList.add('preview-enter');
					preview?.scrollTo({ top: 0, behavior: 'smooth' });
				};

				if (currentPreview) {
					currentPreview.removeAttribute('data-preview-active');
					currentPreview.classList.remove('preview-enter');
					currentPreview.classList.add('preview-leave');
					window.setTimeout(() => {
						if (!currentPreview.hasAttribute('data-preview-active')) {
							currentPreview.hidden = true;
							currentPreview.classList.remove('preview-leave');
						}
						showNextPreview();
					}, 230);
				} else {
					showNextPreview();
				}

				document.querySelectorAll<HTMLElement>('[data-post]').forEach((item) => {
					if (item.dataset.post === slug) item.setAttribute('data-active', '');
					else item.removeAttribute('data-active');
				});
				page?.classList.add('reading-mode');
				recent?.classList.add('is-reading');
			});
		});

		closeButton?.addEventListener('click', closePreview);
		desktop.addEventListener('change', (event) => {
			if (!event.matches) closePreview();
		});

		const atTop = (element: HTMLElement) => element.scrollTop <= 1;
		const atBottom = (element: HTMLElement) =>
			element.scrollTop + element.clientHeight >= element.scrollHeight - 1;

		[postList, preview].forEach((scroller) => {
			scroller?.addEventListener('wheel', (event) => {
				if (!recent?.classList.contains('is-reading')) return;

				const unit =
					event.deltaMode === WheelEvent.DOM_DELTA_LINE
						? 36
						: event.deltaMode === WheelEvent.DOM_DELTA_PAGE
							? window.innerHeight
							: 1;
				const delta = event.deltaY * unit;
				const startsAtBoundary =
					(delta < 0 && atTop(scroller)) ||
					(delta > 0 && atBottom(scroller));

				if (!startsAtBoundary) {
					stopHandoff();
					return;
				}

				if (Math.abs(delta) > .1) scrollPageBy(delta);
			}, { passive: true });
		});

		window.addEventListener('wheel', (event) => {
			const target = event.target;
			const insidePane =
				target instanceof Node &&
				(postList?.contains(target) || preview?.contains(target));
			if (!insidePane) stopHandoff();
		}, { capture: true, passive: true });
	</script>
</Layout>

<style>
	.intro {
		width: min(100%, 680px);
		padding: 58px 0 116px;
		transition: padding .55s ease;
	}

	h1 { margin: 0; font-size: clamp(31px, 6vw, 45px); font-weight: 500; letter-spacing: -.025em; }
	.intro-note { margin: 28px 0 0; color: var(--muted); font-size: 14px; }
	.section-head { display: flex; align-items: baseline; justify-content: space-between; padding-bottom: 14px; border-bottom: 1px solid var(--line); }
	.section-head h2 { margin: 0; font-family: inherit; font-size: 13px; font-weight: 600; letter-spacing: .08em; }
	.section-head span { color: var(--faint); font-size: 11px; }

	.reading-layout {
		display: grid;
		grid-template-columns: minmax(0, 680px) minmax(0, 0fr);
		gap: 0;
		transition: grid-template-columns .65s cubic-bezier(.22, .72, .24, 1), gap .65s cubic-bezier(.22, .72, .24, 1);
	}

	.post-list {
		min-width: 0;
		scrollbar-width: thin;
		scrollbar-color: var(--line) transparent;
	}

	.post-list article {
		position: relative;
		display: grid;
		grid-template-columns: 80px 1fr 24px;
		gap: 18px;
		padding: 27px 0 28px;
		border-bottom: 1px solid var(--line);
		transition: opacity .3s ease, padding .5s ease;
	}

	.post-meta {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 7px;
		padding-top: 5px;
		color: var(--faint);
		font-size: 11px;
		letter-spacing: .03em;
	}
	.post-meta time { padding: 0; }
	.post-meta span {
		padding: 2px 6px;
		border: 1px solid var(--line);
		border-radius: 999px;
		font-size: 9px;
		letter-spacing: .08em;
	}
	h3 { margin: 0 0 7px; font-family: inherit; font-size: 17px; font-weight: 560; }
	h3 a { text-decoration-color: transparent; text-underline-offset: 5px; transition: color .2s, text-decoration-color .2s; }
	h3 a:hover { text-decoration: underline; text-decoration-color: var(--accent); }
	.post-list article p { margin: 0; color: var(--muted); font-size: 13px; line-height: 1.65; }
	.arrow { align-self: center; color: var(--faint); font-size: 15px; transition: color .2s, transform .2s; }
	.post-list article:hover .arrow { color: var(--accent); transform: translate(2px, -2px); }

	.article-preview {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		align-items: start;
		min-width: 0;
		max-height: 720px;
		overflow: auto;
		opacity: 0;
		transform: translateX(28px);
		pointer-events: none;
		scrollbar-width: thin;
		scrollbar-color: var(--line) transparent;
		transition: opacity .4s ease .18s, transform .55s cubic-bezier(.22, .72, .24, 1) .1s;
	}

	.post-list::-webkit-scrollbar,
	.article-preview::-webkit-scrollbar { width: 5px; }

	.post-list::-webkit-scrollbar-track,
	.article-preview::-webkit-scrollbar-track { background: transparent; }

	.post-list::-webkit-scrollbar-thumb,
	.article-preview::-webkit-scrollbar-thumb {
		border-radius: 999px;
		background: var(--line);
	}

	.post-list::-webkit-scrollbar-thumb:hover,
	.article-preview::-webkit-scrollbar-thumb:hover { background: var(--faint); }

	.preview-close {
		position: sticky;
		top: 20px;
		grid-area: 1 / 1;
		justify-self: end;
		align-self: start;
		z-index: 2;
		width: 30px;
		height: 30px;
		padding: 0;
		border: 1px solid var(--line);
		border-radius: 50%;
		background: transparent;
		color: var(--muted);
		font: 300 20px/1 sans-serif;
		cursor: pointer;
		transition: color .2s, border-color .2s, transform .2s;
	}

	.preview-close:hover { color: var(--text); border-color: var(--muted); transform: rotate(8deg); }
	.preview-content {
		grid-area: 1 / 1;
		padding: 24px 44px 12px 0;
		will-change: opacity, transform;
	}

	.preview-content.preview-enter {
		z-index: 1;
		animation: preview-enter .58s cubic-bezier(.22, .61, .36, 1) both;
	}

	.preview-content.preview-leave {
		pointer-events: none;
		animation: preview-leave .23s ease-in both;
	}

	@keyframes preview-enter {
		from {
			opacity: 0;
			transform: translate3d(0, 10px, 0);
		}
		to {
			opacity: 1;
			transform: translate3d(0, 0, 0);
		}
	}

	@keyframes preview-leave {
		from {
			opacity: 1;
			transform: translate3d(0, 0, 0);
		}
		to {
			opacity: 0;
			transform: translate3d(0, -7px, 0);
		}
	}

	.preview-kicker { margin: 0 0 16px; color: var(--accent); font-size: 10px; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; }
	.preview-content h2 { max-width: 480px; margin: 0 0 14px; font-size: 30px; font-weight: 500; letter-spacing: -.02em; }
	.preview-meta { display: flex; gap: 16px; color: var(--faint); font-size: 10px; }
	.preview-meta time { padding: 0; }
	.preview-prose { padding: 34px 0 18px; font-family: var(--font-serif); font-size: 16px; line-height: 2; }
	.preview-prose :global(p) { margin: 0 0 1.4em; }
	.preview-prose :global(h2),
	.preview-prose :global(h3) {
		margin: 1.8em 0 .7em;
		font-family: var(--font-sans);
		font-weight: 560;
		line-height: 1.45;
	}
	.preview-prose :global(h2) { font-size: 21px; }
	.preview-prose :global(h3) { font-size: 17px; }
	.preview-prose :global(ul),
	.preview-prose :global(ol) { margin: 0 0 1.5em; padding-left: 1.4em; }
	.preview-prose :global(blockquote) {
		margin: 1.8em 0;
		padding-left: 1.2em;
		border-left: 2px solid var(--accent);
		color: var(--muted);
	}
	.preview-prose :global(code) {
		padding: .12em .35em;
		border-radius: 4px;
		background: color-mix(in srgb, var(--text) 7%, transparent);
		font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
		font-size: .86em;
	}
	.preview-prose :global(pre) {
		overflow-x: auto;
		margin: 1.8em 0;
		padding: 16px 18px;
		border: 1px solid var(--line);
		border-radius: 7px;
		line-height: 1.7;
	}
	.preview-prose :global(pre code) { padding: 0; background: transparent; }
	.preview-prose :global(a) { text-decoration: underline; text-underline-offset: 4px; }
	.open-page { display: inline-block; color: var(--muted); font-size: 12px; }
	.open-page:hover { color: var(--accent); }

	@media (min-width: 900px) {
		.recent.is-reading .reading-layout {
			grid-template-columns: minmax(0, 350px) minmax(0, 1fr);
			gap: 68px;
			height: clamp(380px, 68vh, 720px);
			align-items: stretch;
		}

		.recent.is-reading .post-list,
		.recent.is-reading .article-preview {
			height: 100%;
			max-height: none;
			overflow-y: auto;
			overscroll-behavior-y: contain;
			scrollbar-gutter: stable;
		}

		.recent.is-reading .article-preview {
			opacity: 1;
			transform: translateX(0);
			pointer-events: auto;
			padding-right: 8px;
		}

		.recent.is-reading .post-list { padding-right: 12px; }

		.recent.is-reading .post-list article {
			grid-template-columns: 54px 1fr 18px;
			gap: 10px;
			padding: 22px 0;
		}

		.recent.is-reading .post-list article:not([data-active]) { opacity: .45; }
		.recent.is-reading .post-list article[data-active] h3 a { color: var(--accent); }
		.recent.is-reading .post-list article p { display: none; }
	}

	@media (max-width: 899px) {
		.article-preview { display: none; }
	}

	@media (max-width: 560px) {
		.intro { padding: 42px 0 88px; }
		.post-list article { grid-template-columns: 1fr 20px; gap: 10px; }
		.post-list .post-meta {
			grid-column: 1 / -1;
			flex-direction: row;
			align-items: center;
			padding: 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.preview-content.preview-enter,
		.preview-content.preview-leave { animation: none; }
	}
</style>
