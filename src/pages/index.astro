---
import Layout from '../layouts/Layout.astro';
import { posts } from '../data/posts';

const recentPosts = posts.slice(0, 10);
import '../styles/home.css';
---

<Layout>
	<section class="intro">
		<p class="eyebrow">Notes from everyday life</p>
		<h1>欢迎各位<span class="welcome-accent">！</span><br />这里记录生活，<br />也分享知识与思考。</h1>
		<p class="intro-note">不追赶信息，只收藏值得反复想起的东西。</p>
	</section>

	<section class="recent" aria-labelledby="recent-title">
		<div class="section-head">
			<h2 id="recent-title">最近文章</h2>
			<span>{String(recentPosts.length).padStart(2, '0')} 篇</span>
		</div>

		<div class="reading-layout">
			<div class="post-list">
				{recentPosts.map((post, index) => (
					<article
						data-post={post.slug}
						style={`--reveal-delay: ${0.46 + index * 0.08}s`}
					>
						<div class="post-meta">
							<time datetime={post.date}>{post.displayDate}</time>
							<span>{post.category}</span>
						</div>
						<div>
							<h3>
								<a href={`/posts/${post.slug}`} data-preview-link={post.slug}>{post.title}</a>
							</h3>
							<p>{post.description}</p>
						</div>
						<a
							class="arrow"
							href={`/posts/${post.slug}`}
							data-preview-link={post.slug}
							aria-label={`阅读《${post.title}》`}
						>↗</a>
					</article>
				))}
			</div>

			<aside class="article-preview" aria-live="polite">
				<button class="preview-close" type="button" aria-label="关闭文章预览">×</button>
				{recentPosts.map((post) => (
					<article class="preview-content" data-preview={post.slug} hidden>
						<p class="preview-kicker">Reading now</p>
						<h2>{post.title}</h2>
						<div class="preview-meta">
							<time datetime={post.date}>{post.date.replaceAll('-', ' / ')}</time>
							<span>{post.category}</span>
							<span>{post.readTime}阅读</span>
						</div>
						<div class="preview-prose">
							<p>点击文章后载入正文。</p>
						</div>
						<a class="open-page" href={`/posts/${post.slug}`}>在独立页面阅读 →</a>
					</article>
				))}
			</aside>
		</div>
	</section>

	<script src="../scripts/home.ts"></script>
</Layout>
