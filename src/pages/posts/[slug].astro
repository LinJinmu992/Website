---
import Layout from '../../layouts/Layout.astro';
import { posts } from '../../data/posts';

export function getStaticPaths() {
	return posts.map((post) => ({ params: { slug: post.slug } }));
}

const post = posts.find((item) => item.slug === Astro.params.slug);
if (!post) {
	return Astro.redirect('/articles');
}
const Content = post.Content;
---

<Layout title={`${post.title} · 林衿慕`} description={post.description}>
	<article class="post">
		<header>
			<a class="back" href="/articles" data-return-link>← 返回文章</a>
			<h1>{post.title}</h1>
			<div class="meta">
				<time datetime={post.date}>{post.date.replaceAll('-', ' / ')}</time>
				<span>{post.category}</span>
				<span>{post.readTime}阅读</span>
			</div>
		</header>
		<div class="prose">
			<Content />
		</div>
		<footer class="post-end">
			<span>完</span>
			<a href="/articles" data-return-link>继续看看其他文章 →</a>
		</footer>
	</article>

	<script>
		const returnLinks = document.querySelectorAll<HTMLAnchorElement>('[data-return-link]');
		const sourcePaths = ['/articles', '/archive'];
		const normalizePath = (path: string) => path.replace(/\/$/, '') || '/';
		const referrer = document.referrer ? new URL(document.referrer) : null;
		const referrerPath = referrer?.origin === location.origin ? normalizePath(referrer.pathname) : '';
		const sourcePath = sourcePaths.includes(referrerPath) ? referrerPath : '';

		if (sourcePath) {
			returnLinks.forEach((link) => {
				link.href = sourcePath;
				if (sourcePath === '/archive') {
					link.textContent = link.classList.contains('back') ? '← 返回归档' : '继续看看归档 →';
				}
			});
		}

		returnLinks.forEach((link) => {
			link.addEventListener('click', () => {
				if (sourcePath) link.href = sourcePath;
			});
		});
	</script>
</Layout>

<style>
	.post { padding-top: 34px; }
	.post header { padding: 24px 0 54px; border-bottom: 1px solid var(--line); }
	.back { color: var(--muted); font-size: 12px; }
	h1 { max-width: 590px; margin: 46px 0 22px; font-size: clamp(34px, 7vw, 48px); font-weight: 500; letter-spacing: -.025em; }
	.meta { display: flex; gap: 18px; color: var(--faint); font-size: 11px; }
	.prose { min-width: 0; max-width: 100%; padding: 52px 0 34px; overflow-wrap: anywhere; font-family: var(--font-serif); font-size: 18px; line-height: 2.05; }
	.prose :global(p) { margin: 0 0 1.65em; }
	.prose :global(img),
	.prose :global(video),
	.prose :global(iframe) {
		display: block;
		max-width: 100%;
		height: auto;
		margin: 2em auto;
		border-radius: 7px;
	}
	.prose :global(figure) { max-width: 100%; margin: 2em 0; }
	.prose :global(figure img) { margin: 0 auto; }
	.prose :global(figcaption) { margin-top: .7em; color: var(--faint); font-size: .78em; text-align: center; }
	.prose :global(table) { display: block; max-width: 100%; overflow-x: auto; }
	.prose :global(h2),
	.prose :global(h3) {
		margin: 2em 0 .75em;
		font-family: var(--font-sans);
		font-weight: 560;
		line-height: 1.45;
	}
	.prose :global(h2) { font-size: 27px; }
	.prose :global(h3) { font-size: 21px; }
	.prose :global(ul),
	.prose :global(ol) { margin: 0 0 1.65em; padding-left: 1.5em; }
	.prose :global(li) { margin-bottom: .4em; }
	.prose :global(blockquote) {
		margin: 2em 0;
		padding-left: 1.3em;
		border-left: 2px solid var(--accent);
		color: var(--muted);
	}
	.prose :global(code) {
		padding: .12em .38em;
		border-radius: 4px;
		background: color-mix(in srgb, var(--text) 7%, transparent);
		font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
		font-size: .84em;
	}
	.prose :global(pre) {
		overflow-x: auto;
		margin: 2em 0;
		padding: 18px 20px;
		border: 1px solid var(--line);
		border-radius: 7px;
		font-size: 15px;
		line-height: 1.7;
	}
	.prose :global(pre code) { padding: 0; background: transparent; }
	.prose :global(a) {
		text-decoration: underline;
		text-decoration-color: var(--accent);
		text-underline-offset: 5px;
	}
	.post-end { display: flex; justify-content: space-between; padding: 25px 0; border-top: 1px solid var(--line); color: var(--muted); font-size: 12px; }
	.post-end span { color: var(--accent); }
	.post-end a:hover { color: var(--text); }
	@media (max-width: 560px) {
		.post { padding-top: 10px; }
		.post header { padding-bottom: 44px; }
		h1 { margin-top: 38px; }
		.prose { font-size: 17px; }
	}
</style>
