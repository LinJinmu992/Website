# Admin
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
ADMIN_HOST=127.0.0.1
ADMIN_PORT=4322
ADMIN_AUTH_DISABLED=false
BLOG_AUTO_BUILD=true

# Cloudflare R2 upload and private backup
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=blog
R2_PUBLIC_BASE_URL=

# Cloudflare Wrangler CLI
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Private article repository (store only the private-key path here)
CONTENT_GIT_ENABLED=false
CONTENT_GIT_REPOSITORY=git@github-blog:OWNER/Blog-Content.git
CONTENT_GIT_BRANCH=main
CONTENT_GIT_SSH_KEY_PATH=/root/.ssh/linjinmu_blog_github
CONTENT_GIT_AUTHOR_NAME=LinJinmu
CONTENT_GIT_AUTHOR_EMAIL=
CONTENT_GIT_WORKTREE=server/data/content-repository

# SQLite backup (schedule `npm run backup` once a day on the VPS)
BLOG_BACKUP_DIR=server/backups
BLOG_BACKUP_RETENTION_DAYS=14
